# Default API URL for production builds. Committed on purpose: this is a public
# endpoint, not a secret, and it makes `vercel deploy` work with no dashboard setup.
#
# Vite reads this at BUILD time. A real environment variable of the same name
# (e.g. one set in Vercel Project Settings) takes precedence over this file, so
# you can still point a deployment somewhere else without changing code.
VITE_API_BASE_URL=https://trishakti-crm-api.onrender.com/api
