# ---- Database (PostgreSQL) ----
POSTGRES_DB=trishakti_crm
POSTGRES_USER=trishakti
POSTGRES_PASSWORD=trishakti

# ---- Backend ----
DB_URL=jdbc:postgresql://postgres:5432/trishakti_crm
DB_USER=trishakti
DB_PASSWORD=trishakti
JWT_SECRET=please-change-this-to-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,capacitor://localhost
SEED_ENABLED=true

# ---- Web ----
VITE_API_BASE_URL=http://localhost:8080/api

# ---- Production deployment ----
# Render API URL, including the /api context path.
# VITE_API_BASE_URL=https://trishakti-crm-api.onrender.com/api
# CORS_ALLOWED_ORIGINS=https://your-project.vercel.app,https://*.vercel.app
#
# On Render the database connection is injected by render.yaml as
# DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD (profile: render).
